HOST=127.0.0.1
PORT=8787
PUBLIC_ORIGIN=https://translate.playground.computer
# Generate two DIFFERENT tokens with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEVICE_TOKEN=replace-with-a-random-device-token-at-least-24-characters
DASHBOARD_TOKEN=replace-with-a-different-random-dashboard-token-at-least-24-characters
# Browser login. Set both before starting/updating the service (password: at least 12 characters).
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
# DASHBOARD_TOKEN stays server-side as the session-signing secret; do not enter it in the browser.
LOG_DIR=./logs
# Add your key here on Ubuntu. Never put it in the dashboard or APK.
OPENAI_API_KEY=
TARGET_LANGUAGE=en
RECORDINGS_DIR=./recordings
