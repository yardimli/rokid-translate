[Unit]
Description=Rokid microphone and caption diagnostic server
After=network.target

[Service]
Type=simple
User=rokid-test
Group=rokid-test
WorkingDirectory=/opt/rokid-translate/server
ExecStart=/usr/bin/node --env-file=/opt/rokid-translate/server/.env /opt/rokid-translate/.deploy/current/src/index.js
Restart=on-failure
RestartSec=3
Environment=NODE_ENV=production
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/rokid-translate/server/logs /opt/rokid-translate/server/recordings
UMask=0077

[Install]
WantedBy=multi-user.target
